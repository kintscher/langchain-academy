# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored — never commit real keys.

# --- Required ---
# Anthropic API key — used by every notebook for the Claude chat model.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Recommended ---
# LangSmith tracing (free tier available). Lets you inspect runs in the LangSmith UI.
# Sign up at https://smith.langchain.com/
LANGSMITH_API_KEY=lsv2-xxx
LANGSMITH_TRACING_V2=true
LANGSMITH_PROJECT=langchain-academy
# Uncomment the line below ONLY if you are on the EU LangSmith instance:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Optional (used by Module 4 lessons that call web search) ---
# Tavily is a search API optimized for LLMs/RAG. Generous free tier.
# Sign up at https://tavily.com/
TAVILY_API_KEY=tvly-xxx
